# Токен Telegram-бота
# Получить: @BotFather → /newbot
BOT_TOKEN=your-bot-token-here

# Chat ID аккаунта оператора в Telegram
# Получить: запустить бота → открыть /api/chatid в браузере
ADMIN_CHAT_ID=123456789

# Токен для веб-панели оператора (admin.html)
# Придумайте любую строку, передайте оператору вместе со ссылкой
ADMIN_TOKEN=your-secret-token-here

# URL фронтенда для CORS (через запятую, без пробелов)
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:5173
